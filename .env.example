# Copy to .env and fill in. Generate keys with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NODE_ENV=development
PORT=4000
# local = libSQL file (apps/api/local.db); remote = Turso
DB_MODE=local
LOCAL_DB_URL=file:local.db
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<generate-me>
JWT_SECRET=<generate-me>
ENCRYPTION_KEY=<generate-me>
BLIND_INDEX_KEY=<generate-me>
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://guyka2212.github.io
PUBLIC_GUEST_URL=http://localhost:5173
PUBLIC_SHOP_URL=http://localhost:5174
API_PUBLIC_URL=http://localhost:4000
AUTO_VERIFY_PARENT=true
RESEND_API_KEY=
EMAIL_FROM=Birthday Wish List <onboarding@resend.dev>
